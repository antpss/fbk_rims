# Bytecode and runtime artifacts
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
.env

# IDE and OS files
.idea/
.vscode/
*.swp
.DS_Store

# Reference and legacy folders
RIMS/
RIMS_tool/
RIMS_decision_points/
context.md

# Intermediate ML artifacts
**/catboost_info/

# Datasets and large logs (track directory skeleton via .gitkeep, ignore data files)
data/**
!data/**/
!data/**/*.gitkeep
*.xes
*.xes.gz
*.csv

# Generated candidate models (ignore candidate tournaments, track champion runtime models)
models/duration/*
!models/duration/hybrid_champion/
models/waiting_time/*
!models/waiting_time/hybrid_champion/

# Visual artifacts
*.png
