# Bytecode and runtime artifacts
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
.env

# IDE and OS files
.idea/
.vscode/
*.swp
.DS_Store

# Reference and legacy folders
RIMS/
RIMS_tool/
RIMS_decision_points/
context.md
original_rims_source
scraped_rims_docs
scraped_doc.html
tests/

# Intermediate ML artifacts
**/catboost_info/

# Datasets and large logs (ignore heavy logs, datasets, and run exports)
*.xes
*.xes.gz
*.csv
data/generated/

# Track documentation, benchmark reports, and configuration metadata inside data/
!data/**/*.md
!data/**/*.json

# Generated candidate models (ignore candidate tournaments, track champion runtime models)
models/duration/*
!models/duration/hybrid_champion/
models/waiting_time/*
!models/waiting_time/hybrid_champion/

# Visual artifacts
*.png
