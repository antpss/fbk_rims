# Bytecode and runtime artifacts
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
.env

# IDE and OS files
.idea/
.vscode/
*.swp
.DS_Store

# Reference and legacy folders
RIMS/
RIMS_tool/
RIMS_decision_points/
context.md
original_rims_source
scraped_rims_docs
scraped_doc.html
codebase.txt
docs/

# Intermediate ML artifacts
**/catboost_info/

# Datasets and large logs (ignore heavy logs, datasets, and run exports)
*.xes
*.xes.gz
*.csv
*.csv.gz
*.parquet
*.log
data/generated/

# Track documentation, benchmark reports, and configuration metadata inside data/
!data/**/*.md
!data/**/*.json

# Per-run case assignments and provenance are regenerated with the datasets/models.
data/processed/case_split.json
*.provenance.json

# Generated timing models, including champion bundles. Keep small top-level
# champion metrics, but rebuild runtime bundles locally.
models/duration/*
!models/duration/hybrid_champion/
models/duration/hybrid_champion/*
!models/duration/hybrid_champion/metrics.json
models/waiting_time/*
!models/waiting_time/hybrid_champion/
models/waiting_time/hybrid_champion/*
!models/waiting_time/hybrid_champion/metrics.json

# Visual artifacts
*.png
